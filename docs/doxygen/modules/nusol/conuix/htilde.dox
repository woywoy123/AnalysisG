/**
 * @file src/AnalysisG/modules/nusol/conuix/include/conuix/htilde.h
 * @brief Struct definitions for various mathematical parameters in the Conuix namespace.
 *
 * Contains basic data structures to carry mathematical objects like kinematics, rotations,
 * base states, pencils, scales, and matrices between different stages of the neutrino
 * kinematic solver algorithms.
 *
 * @namespace Conuix
 * @brief Namespace encapsulating auxiliary solver structs and parameter extractors.
 *
 * @struct Conuix::kinematic_t
 * @brief Encapsulates relevant kinematic parameters (px, py, pz, e).
 *
 * @struct Conuix::rotation_t
 * @brief Encapsulates a rotation matrix state.
 *
 * @struct Conuix::base_t
 * @brief Encapsulates base frame variables mapping from lab frame.
 *
 * @struct Conuix::thetapsi_t
 * @brief Encapsulates theta and psi angles.
 *
 * @struct Conuix::pencil_t
 * @brief Defines the geometric pencil of conics associated with the constraints.
 *
 * @struct Conuix::Sx_t
 * @brief Scale factor parameter in X.
 *
 * @struct Conuix::Sy_t
 * @brief Scale factor parameter in Y.
 *
 * @struct Conuix::H_matrix_t
 * @brief Encapsulates the core H-matrix for ellipse constraints.
 */
