PROJECT_NAME = "AnalysisG"
OUTPUT_DIRECTORY = docs/build/doxygen
INPUT = src/AnalysisG pyc
RECURSIVE = YES
FILE_PATTERNS = *.h *.hpp *.hh *.cxx *.cc *.cpp
EXCLUDE_PATTERNS = */build/* */test/* */tests/* */templates/*

GENERATE_HTML = NO
GENERATE_XML = YES
XML_OUTPUT = xml

EXTRACT_ALL = YES
EXTRACT_PRIVATE = NO
EXTRACT_STATIC = YES
EXTRACT_LOCAL_CLASSES = YES

HAVE_DOT = YES
CLASS_GRAPH = YES
COLLABORATION_GRAPH = YES
GRAPHICAL_HIERARCHY = YES
INCLUDE_GRAPH = NO
INCLUDED_BY_GRAPH = NO
DOT_IMAGE_FORMAT = svg

QUIET = YES
WARN_IF_UNDOCUMENTED = NO
WARN_IF_DOC_ERROR = YES

ENABLE_PREPROCESSING = YES
MACRO_EXPANSION = YES
SEARCH_INCLUDES = YES
INCLUDE_PATH = src/AnalysisG pyc
