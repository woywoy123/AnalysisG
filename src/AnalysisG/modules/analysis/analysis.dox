/**
 * \class analysis
 * \brief The central orchestration engine for the AnalysisG framework.
 *
 * The `analysis` class serves as the primary C++ backend manager. It orchestrates the entire pipeline, from loading data samples (ROOT/HDF5) to executing graph neural network models and calculating physics metrics. It inherits from `notification` for CLI logging and `tools` for general utilities.
 *
 * \fn analysis::analysis()
 * \brief Default constructor initializing the analysis engine and state variables.
 *
 * \fn void analysis::add_samples(std::string path, std::string label)
 * \brief Registers data samples into the analysis pipeline.
 * \param path The filesystem path to the data (supports wildcards and directories).
 * \param label An internal label to group these samples (e.g., "Signal", "Background").
 *
 * \fn void analysis::add_selection_template(selection_template* sel)
 * \brief Injects a physics selection or cut-flow template into the event loop.
 * \param sel A pointer to a dynamically allocated `selection_template` derived class.
 *
 * \fn void analysis::add_event_template(event_template* ev, std::string label)
 * \brief Registers an event structure definition so the backend knows how to unpack the incoming TTree branches.
 * \param ev Pointer to an `event_template`.
 * \param label A unique label string corresponding to the dataset.
 *
 * \fn void analysis::add_graph_template(graph_template* gr, std::string label)
 * \brief Defines the graph topology construction logic for transforming events into node/edge graph representations.
 *
 * \fn void analysis::add_metric_template(metric_template* mx, model_template* mdl)
 * \brief Hooks a metric calculation template into the inference/training loop for a specific model.
 *
 * \fn void analysis::add_model(model_template* model, optimizer_params_t* op, std::string run_name)
 * \brief Injects a PyTorch/C++ GNN model into the engine for **training**, complete with optimizer configurations.
 *
 * \fn void analysis::add_model(model_template* model, std::string run_name)
 * \brief Injects a PyTorch/C++ GNN model into the engine for **inference** only.
 *
 * \fn void analysis::start()
 * \brief Kicks off the internal execution loops. Based on the registered templates, it sequentially runs:
 *  - Event Building (`build_events`)
 *  - Graph Construction (`build_graphs`)
 *  - Selection processing (`build_selections`)
 *  - Model Training/Inference (`build_model_session`, `build_inference`)
 *
 * \fn std::map<std::string, std::vector<float>> analysis::progress()
 * \brief Returns a dictionary containing progress metrics (useful for the Cython/Python frontend to render TQDM bars).
 *
 * \var analysis::m_settings
 * \brief The global configuration struct holding epochs, batch sizes, threads, output paths, and K-Fold settings.
 */
